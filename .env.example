# =============================================================================
# mcp-local-rag — Шаблон конфигурации
# =============================================================================
# Скопируйте этот файл в .env и заполните значения:
#   copy .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# БАЗОВЫЕ НАСТРОЙКИ
# -----------------------------------------------------------------------------

# Корневая директория документов для индексации
# Если нужно несколько директорий, используйте BASE_DIRS (JSON-массив)
BASE_DIR=./docs

# JSON-массив корневых директорий (альтернатива BASE_DIR)
# Пример: ["./docs", "C:/Users/me/notes"]
# BASE_DIRS=

# Путь к векторной базе данных (LanceDB)
DB_PATH=./lancedb

# Директория кэша для моделей
CACHE_DIR=./models

# -----------------------------------------------------------------------------
# НАСТРОЙКИ ЭМБЕДДИНГОВ
# -----------------------------------------------------------------------------

# Бэкенд эмбеддингов: transformers (встроенный) или llama-cpp (локальная модель)
# transformers — работает из коробки, использует Transformers.js
# llama-cpp — требует запущенный сервер llama.cpp с GGUF-моделью
EMBEDDING_BACKEND=transformers

# HuggingFace модель для Transformers.js бэкенда
# Xenova/all-MiniLM-L6-v2 — быстрая и легкая (~220 MB)
MODEL_NAME=Xenova/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# НАСТРОЙКИ LLAMA.CPP (только если EMBEDDING_BACKEND=llama-cpp)
# -----------------------------------------------------------------------------

# URL сервера llama.cpp
LLAMA_CPP_SERVER_URL=http://127.0.0.1:8080

# Размер батча для обработки (1–128)
LLAMA_CPP_BATCH_SIZE=16

# Таймаут запроса к серверу llama.cpp (в миллисекундах)
LLAMA_CPP_TIMEOUT=30000

# Размерность эмбеддингов (переопределение, если нужно)
# Qwen3-Embedding-4B: 4096
# nomic-embed-text-v1.5: 768
RAG_LLAMA_CPP_DIMENSIONS=4096

# -----------------------------------------------------------------------------
# НАСТРОЙКИ ПОИСКА
# -----------------------------------------------------------------------------

# Вес keyword boost (0.0–1.0)
# Чем выше значение, тем больше веса точным терминам
RAG_HYBRID_WEIGHT=0.6

# -----------------------------------------------------------------------------
# ПРОИЗВОДИТЕЛЬНОСТЬ
# -----------------------------------------------------------------------------

# Устройство выполнения: cpu или webgpu
# webgpu — требует совместимый браузер/Node.js
RAG_DEVICE=cpu

# -----------------------------------------------------------------------------
# ВИЗУАЛЬНЫЙ РЕЖИМ PDF (опционально)
# -----------------------------------------------------------------------------

# fast: SmolVLM-256M (~250 MB) — быстрая генерация подписей
# quality: Qwen2.5-VL-3B (~2.9 GB) — качественная генерация
# PDF_VLM_MODEL=fast

# -----------------------------------------------------------------------------
# БЕЗОПАСНОСТЬ
# -----------------------------------------------------------------------------

# Ограничить доступ только к определенным директориям (JSON-массив)
# SECURITY_ALLOWED_DIRS=

# -----------------------------------------------------------------------------
# ТЕЛЕМЕТРИЯ
# -----------------------------------------------------------------------------

# Отключить сбор телеметрии OpenSpec (если используется)
# OPENSPEC_TELEMETRY=0
# DO_NOT_TRACK=1
